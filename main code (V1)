    .screen[hidden] { display: none !important; }

    .site-nav {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(11, 11, 11, .96);
      border-bottom: 1px solid #4a4a4a;
      backdrop-filter: blur(14px);
    }

    .brand-mark {
      width: 44px;
      height: 44px;
      overflow: hidden;
      border: 1px solid #888;
      border-radius: 50%;
      background: #202020;
      box-shadow: inset 0 0 0 4px #101010;
    }

    .nav-link {
      position: relative;
      color: #e8e8e8;
      padding: .55rem .15rem;
      transition: color .2s ease;
    }

    .nav-link:hover,
    .nav-link:focus-visible,
    .nav-link.is-active { color: #ffffff; }

    .nav-link.is-active::after {
      position: absolute;
      bottom: -.36rem;
      left: 0;
      width: 100%;
      height: 2px;
      content: "";
      background: #f7f7f7;
    }

    .menu-popover {
      position: absolute;
      top: calc(100% + 13px);
      left: 50%;
      width: 225px;
      padding: 1rem;
      background: #1b1b1b;
      border: 1px solid #606060;
      box-shadow: 0 18px 48px rgba(0,0,0,.55);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(-50%) translateY(-6px);
      transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
    }

    .menu-trigger:hover .menu-popover,
    .menu-trigger:focus-within .menu-popover {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }

    .hero-panel {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 535px;
      overflow: hidden;
      border-bottom: 1px solid #454545;
      background: #111;
    }

    .hero-panel::after {
      position: absolute;
      inset: 0;
      z-index: 1;
      content: "";
      background: linear-gradient(90deg, rgba(5,5,5,.97) 5%, rgba(5,5,5,.82) 45%, rgba(5,5,5,.28) 100%);
    }

    .hero-panel img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(1) contrast(1.12);
    }

    .hero-content { position: relative; z-index: 2; }

    .silver-rule {
      display: inline-block;
      width: 58px;
      height: 2px;
      background: #e9e9e9;
    }

    .mono-button {
      border: 1px solid #f7f7f7;
      background: #f7f7f7;
      color: #111;
      font-weight: 800;
      transition: background .2s ease, color .2s ease, transform .2s ease;
    }

    .mono-button:hover {
      background: #1d1d1d;
      color: #fff;
      transform: translateY(-2px);
    }

    .mono-button:disabled {
      cursor: wait;
      opacity: .62;
      transform: none;
    }

    .section-black { background: #0b0b0b; }

    .section-light {
      background: #ededed;
      color: #151515;
    }

    .product-card {
      overflow: hidden;
      border: 1px solid #4d4d4d;
      background: #191919;
      transition: transform .25s ease, border-color .25s ease;
    }

    .product-card:hover {
      border-color: #e4e4e4;
      transform: translateY(-6px);
    }

    .product-photo {
      width: 100%;
      height: 215px;
      object-fit: cover;
      filter: grayscale(1) contrast(1.08);
      background: #2b2b2b;
    }

    .price-tag {
      min-width: 54px;
      padding: .35rem .7rem;
      border-radius: 999px;
      background: #eeeeee;
      color: #101010;
      font-weight: 800;
      text-align: center;
    }

    .menu-row { border-bottom: 1px solid #4b4b4b; }

    .contact-field {
      width: 100%;
      padding: .82rem .9rem;
      border: 1px solid #797979;
      border-radius: .25rem;
      background: #fff;
      color: #161616;
    }

    .contact-field::placeholder { color: #777; }

    .contact-field:focus {
      border-color: #111;
      outline: 3px solid rgba(17,17,17,.2);
      outline-offset: 2px;
    }

    .status-message { min-height: 1.5rem; }

    .fade-in { animation: rise .6s ease both; }
    .fade-delay { animation: rise .7s .12s ease both; }

    @keyframes rise {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }

    button:focus-visible,
    .nav-link:focus-visible,
    input:focus-visible,
    textarea:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 3px;
    }

    @media (max-width: 640px) {
      .hero-panel { min-height: 500px; }
      .hero-panel::after { background: linear-gradient(90deg, rgba(5,5,5,.96), rgba(5,5,5,.62)); }
      .nav-link { font-size: .78rem; }
      .brand-name-text { font-size: .92rem; }
    }
