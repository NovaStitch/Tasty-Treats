        <label data-template-id="contact-email-label" class="canva-text block font-bold mb-2" for="contact-email"></label> <input id="contact-email" class="contact-field" type="email" autocomplete="email" required>
       </div>
       <div>
        <label data-template-id="contact-message-label" class="canva-text block font-bold mb-2" for="contact-message"></label> <textarea id="contact-message" class="contact-field min-h-32 resize-y" required></textarea>
       </div><button data-template-id="contact-submit-button" class="canva-button mono-button justify-self-start px-6 py-3 rounded-sm" type="submit"></button>
       <p id="form-status" class="status-message font-semibold" aria-live="polite"></p>
       <p data-template-id="contact-helper" class="canva-text text-sm"></p>
      </form>
     </div>
    </section>
   </main>
   <footer data-template-id="site-footer" class="canva-footer border-t border-[#4a4a4a] text-center px-6 py-6">
    <p data-template-id="footer-text" class="canva-text text-sm"></p>
   </footer>
  </div>
  <script>
    const screens = document.querySelectorAll("[data-screen]");
    const navButtons = document.querySelectorAll(".nav-link");
    const viewButtons = document.querySelectorAll("[data-view-target]");
    const statusMessage = document.getElementById("form-status");
    const contactForm = document.getElementById("contact-form");
    let sheetReady = false;

    function showView(viewName) {
      screens.forEach((screen) => {
        screen.hidden = screen.dataset.screen !== viewName;
      });

      navButtons.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.viewTarget === viewName);
      });

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function showFormStatus(message, isError) {
      statusMessage.textContent = message;
      statusMessage.style.color = isError ? "#8b1e1e" : "#1f5b35";
    }

    viewButtons.forEach((button) => {
      button.addEventListener("click", () => showView(button.dataset.viewTarget));
    });

    async function initializeSheet() {
      if (!window.dataSdk) {
        showFormStatus("Messages are unavailable right now. Please try again shortly.", true);
        return;
      }

      const initResult = await window.dataSdk.init({
        onDataChanged() {
          sheetReady = true;
        }
      });

      if (!initResult.isOk) {
        showFormStatus("Messages are unavailable right now. Please try again shortly.", true);
        return;
      }

      sheetReady = true;
    }

    async function submitContact(event) {
      event.preventDefault();

      const submitButton = event.submitter;
      const name = document.getElementById("contact-name").value.trim();
      const email = document.getElementById("contact-email").value.trim();
      const message = document.getElementById("contact-message").value.trim();

      if (!name || !email || !message) {
        showFormStatus("Please complete all three fields before sending.", true);
        return;
      }

      if (!sheetReady || !window.dataSdk) {
        showFormStatus("Messages are unavailable right now. Please try again shortly.", true);
        return;
      }

      submitButton.disabled = true;
      showFormStatus("Sending your message…", false);

      try {
        const result = await window.dataSdk.create({
          name,
          email,
          message,
          submitted_at: new Date().toISOString()
        });

        if (!result.isOk) {
          showFormStatus("We could not confirm your message. Please try again.", true);
          return;
        }

        contactForm.reset();
        showFormStatus("Thanks! Your message has been sent to Tasty Treats.", false);
      } catch (error) {
        showFormStatus("We could not send your message. Please try again.", true);
      } finally {
        submitButton.disabled = false;
      }
    }

    contactForm.addEventListener("submit", submitContact);

    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      initializeSheet();
    });
  </script>
 </body>
</html>
